# Hosted video generation
OPENROUTER_API_KEY=
OPENROUTER_VIDEO_MODEL=google/veo-3.1-lite
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=AI Content Factory Studio

# Self-hosted / rented GPU generation
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_API_TOKEN=
COMFYUI_CLIENT_ID=ai-content-factory-studio

# Export a tested ComfyUI workflow in API format and configure it server-side.
# The bindings object maps portable fields such as prompt, duration, resolution,
# aspectRatio, generateAudio, reference0, frame_first_frame, etc. to graph node inputs.
COMFYUI_WORKFLOW_JSON=
COMFYUI_BINDINGS_JSON=

# Unsafe escape hatch for local development only. Keep false in deployed environments.
COMFYUI_ALLOW_CLIENT_WORKFLOW_OVERRIDES=false

# Durable factory state. Required in production unless an intentionally ephemeral
# deployment explicitly sets STUDIO_ALLOW_EPHEMERAL_STORE=true.
# Works with normal Postgres, Supabase Postgres, Neon, etc.
DATABASE_URL=
DATABASE_POOL_SIZE=5
STUDIO_ALLOW_EPHEMERAL_STORE=false

# Internal Studio access control. Required in production.
STUDIO_BASIC_AUTH_USER=
STUDIO_BASIC_AUTH_PASSWORD=
STUDIO_ALLOW_INSECURE_DEV=true

# Optional per-generation safety cap. A generation with a known live estimate above
# this value is rejected before provider submission. Leave blank to disable.
STUDIO_MAX_ESTIMATED_COST_USD=

# Used by legacy Archon/Python workers when calling generation_gateway.py.
CONTENT_STUDIO_URL=http://localhost:3000
CONTENT_STUDIO_BASIC_AUTH_USER=
CONTENT_STUDIO_BASIC_AUTH_PASSWORD=
