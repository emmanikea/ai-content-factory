# UGC Studio provider credentials and runtime policy
# Copy this file to `.env` at the repository root and fill in only the providers you use.
# NEVER commit `.env` or real credentials.

# -----------------------------------------------------------------------------
# ComfyUI — preferred reusable workflow engine
# -----------------------------------------------------------------------------
# Local/self-hosted is the default. If ComfyUI is launched on a non-default address,
# set COMFY_LOCAL_URL (for example http://127.0.0.1:8189).
COMFY_WHERE=local
COMFY_LOCAL_URL=http://127.0.0.1:8188

# Paid Comfy partner/API nodes are OFF for automated runs. A future adapter must require
# explicit human spend approval before honoring this switch.
COMFY_ALLOW_SPEND=0

# -----------------------------------------------------------------------------
# Higgsfield — runtime disabled repository-wide
# -----------------------------------------------------------------------------
# Historical Higgsfield code/research may remain in the repo, but active workflows and agents
# must not call its CLI/API/MCP while this is 0. Re-enabling it is an explicit policy decision.
ENABLE_HIGGSFIELD_RUNTIME=0

# -----------------------------------------------------------------------------
# Optional direct hosted providers / analysis
# -----------------------------------------------------------------------------
# Unified model/video routing and experimentation
OPENROUTER_API_KEY=

# Google Gemini analysis + direct Veo access
GEMINI_API_KEY=
# GOOGLE_API_KEY=  # Optional alias used by some Google tooling; normally GEMINI_API_KEY is enough.

# fal direct video generation (Wan / Kling / Seedance routes already implemented)
FAL_KEY=

# NVIDIA NIM development / benchmark lane
NVIDIA_API_KEY=

# Optional vision fallback already supported by existing analysis tooling
OPENAI_API_KEY=

# Optional provider selection for existing vision tools: auto | gemini | openai
VISION_PROVIDER=auto
