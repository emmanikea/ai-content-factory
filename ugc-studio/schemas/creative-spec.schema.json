{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-content-factory.local/schemas/creative-spec.schema.json",
  "title": "CreativeSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "campaign_id",
    "concept_id",
    "format",
    "duration_seconds",
    "aspect_ratio",
    "hook",
    "angle",
    "creator_id",
    "rights_mode",
    "shots"
  ],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "campaign_id": { "type": "string", "minLength": 1 },
    "concept_id": { "type": "string", "minLength": 1 },
    "reference_id": { "type": ["string", "null"] },
    "format": {
      "type": "string",
      "enum": [
        "ugc_reaction_demo",
        "ugc_testimonial",
        "ugc_problem_solution",
        "ugc_storytime",
        "ugc_listicle",
        "ugc_founder",
        "product_demo",
        "custom"
      ]
    },
    "duration_seconds": { "type": "number", "minimum": 3, "maximum": 90 },
    "aspect_ratio": { "type": "string", "enum": ["9:16", "1:1", "16:9", "4:5"] },
    "render_resolution": { "type": "string", "enum": ["480p", "720p", "1080p"], "default": "720p" },
    "generate_native_audio": { "type": "boolean", "default": false },
    "hook": { "type": "string", "minLength": 1 },
    "angle": { "type": "string", "minLength": 1 },
    "script": { "type": "string" },
    "creator_id": { "type": "string", "minLength": 1 },
    "rights_mode": {
      "type": "string",
      "enum": ["creative_dna_only", "licensed_performance_transfer", "owned_source"]
    },
    "language": { "type": "string", "default": "en" },
    "cta": { "type": "string" },
    "caption_style": { "type": "string" },
    "quality_tier": { "type": "string", "enum": ["draft", "standard", "premium"], "default": "standard" },
    "max_render_cost_usd": { "type": ["number", "null"], "minimum": 0 },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/shot" }
    }
  },
  "$defs": {
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start", "end", "source_type", "purpose"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "exclusiveMinimum": 0 },
        "source_type": {
          "type": "string",
          "enum": [
            "creator_generated",
            "creator_motion_transfer",
            "creator_lipsync",
            "app_capture",
            "product_capture",
            "broll_generated",
            "owned_media",
            "graphic"
          ]
        },
        "purpose": { "type": "string", "minLength": 1 },
        "dialogue": { "type": ["string", "null"] },
        "visual_direction": { "type": ["string", "null"] },
        "capture_script": { "type": ["string", "null"] },
        "motion_reference_id": { "type": ["string", "null"] },
        "asset_reference_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "provider_preference": { "type": ["string", "null"] },
        "provider_fallback": { "type": ["string", "null"] },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "identity_still",
              "text_to_video",
              "image_to_video",
              "reference_to_video",
              "motion_transfer",
              "character_replace",
              "video_edit",
              "voice_clone",
              "speech",
              "lip_sync",
              "broll",
              "app_capture"
            ]
          },
          "uniqueItems": true
        }
      }
    }
  }
}
