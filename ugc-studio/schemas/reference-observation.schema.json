{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-content-factory.local/schemas/reference-observation.schema.json",
  "title": "ReferenceObservation",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source_path", "rights_mode", "duration_seconds", "video", "cuts", "segments"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "source_path": {"type": "string", "minLength": 1},
    "source_sha256": {"type": ["string", "null"]},
    "rights_mode": {"type": "string", "enum": ["creative_dna_only", "licensed_performance_transfer", "owned_source"]},
    "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "video": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {"type": ["integer", "null"], "minimum": 1},
        "height": {"type": ["integer", "null"], "minimum": 1},
        "fps": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "has_audio": {"type": "boolean"}
      }
    },
    "cuts": {
      "type": "array",
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "start", "end"],
        "properties": {
          "id": {"type": "string"},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "exclusiveMinimum": 0},
          "keyframe_path": {"type": ["string", "null"]}
        }
      }
    },
    "transcript": {"type": ["string", "null"]},
    "transcript_segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end", "text"],
        "properties": {
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "minimum": 0},
          "text": {"type": "string"}
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observer_version", "scene_threshold", "semantic_enrichment_required"],
      "properties": {
        "observer_version": {"type": "string"},
        "scene_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "semantic_enrichment_required": {"type": "boolean"},
        "transcription_source": {"type": ["string", "null"]}
      }
    }
  }
}
