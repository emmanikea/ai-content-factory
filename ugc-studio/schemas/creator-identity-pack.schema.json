{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-content-factory.local/schemas/creator-identity-pack.schema.json",
  "title": "CreatorIdentityPack",
  "type": "object",
  "additionalProperties": false,
  "required": ["creator_id", "version", "canonical_images", "rights_snapshot"],
  "properties": {
    "creator_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "canonical_images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "uri", "view"],
        "properties": {
          "id": {"type": "string"},
          "uri": {"type": "string"},
          "view": {
            "type": "string",
            "enum": ["front", "three_quarter", "profile", "full_body", "upper_body", "expression", "other"]
          },
          "lighting": {"type": ["string", "null"]},
          "notes": {"type": ["string", "null"]}
        }
      }
    },
    "voice_samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "uri"],
        "properties": {
          "id": {"type": "string"},
          "uri": {"type": "string"},
          "language": {"type": "string"},
          "style": {"type": ["string", "null"]},
          "duration_seconds": {"type": ["number", "null"], "minimum": 0}
        }
      }
    },
    "performance_samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "uri", "performance_type"],
        "properties": {
          "id": {"type": "string"},
          "uri": {"type": "string"},
          "performance_type": {
            "type": "string",
            "enum": ["talking", "reaction", "gesture", "walking", "product_hold", "turn", "other"]
          },
          "duration_seconds": {"type": ["number", "null"], "minimum": 0},
          "approved_for_motion_transfer": {"type": "boolean", "default": false}
        }
      }
    },
    "appearance_presets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outfits": {"type": "array", "items": {"type": "string"}},
        "hairstyles": {"type": "array", "items": {"type": "string"}},
        "locations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "provider_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "binding_type", "value"],
        "properties": {
          "provider": {"type": "string"},
          "binding_type": {"type": "string"},
          "value": {"type": "string"},
          "portable": {"type": "boolean", "default": true}
        }
      }
    },
    "rights_snapshot": {
      "type": "object",
      "additionalProperties": true,
      "description": "Immutable snapshot/reference to creator rights used when this pack version was created."
    }
  }
}
