{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-content-factory.local/schemas/campaign-brief.schema.json",
  "title": "CampaignBrief",
  "type": "object",
  "additionalProperties": false,
  "required": ["campaign_id", "product", "audience", "platform", "creator_ids", "hook_options", "cta_options"],
  "properties": {
    "campaign_id": {"type": "string", "minLength": 1},
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "category", "kind"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "category": {"type": "string"},
        "kind": {"type": "string", "enum": ["app", "physical_product", "service", "other"]}
      }
    },
    "audience": {"type": "string"},
    "platform": {"type": "string"},
    "target_duration_seconds": {"type": ["number", "null"], "minimum": 3, "maximum": 90},
    "creator_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "hook_options": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "cta_options": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "locations": {"type": "array", "items": {"type": "string"}},
    "outfits": {"type": "array", "items": {"type": "string"}},
    "role_lines": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {"type": "string"},
          {"type": "array", "items": {"type": "string"}, "minItems": 1}
        ]
      }
    },
    "app_capture_script": {"type": ["string", "null"]},
    "product_capture_script": {"type": ["string", "null"]},
    "angle": {"type": ["string", "null"]},
    "language": {"type": "string", "default": "en"},
    "quality_tier": {"type": "string", "enum": ["draft", "standard", "premium"], "default": "standard"},
    "max_render_cost_usd": {"type": ["number", "null"], "minimum": 0},
    "use_literal_motion": {"type": "boolean", "default": false},
    "generate_native_audio": {"type": "boolean", "default": false},
    "max_specs": {"type": "integer", "minimum": 1, "maximum": 200, "default": 24}
  }
}
